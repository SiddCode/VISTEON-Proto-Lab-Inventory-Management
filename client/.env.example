# VISTEON Inventory SaaS - Frontend Environment Configuration

# Local Development:
# Leave empty or set to /api (Vite dev proxy forwards /api -> http://localhost:5000):
# VITE_API_URL=/api

# Production Deployment on Render Static Site:
# Set this to your deployed Render Express backend Web Service URL:
# (Note: trailing slash or /api suffix is automatically normalized by the application)
VITE_API_URL=https://<your-render-backend-web-service>.onrender.com

# Example:
# VITE_API_URL=https://visteon-inventory-api.onrender.com
